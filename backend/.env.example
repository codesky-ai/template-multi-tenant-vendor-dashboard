# إعدادات قاعدة البيانات - Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=suppliers_dashboard_db
DB_PORT=3306

# إعدادات الخادم - Server Configuration
PORT=3001
NODE_ENV=development

# إعدادات الأمان - Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=7d

# إعدادات CORS - CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_CREDENTIALS=true

# إعدادات معدل الطلبات - Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# إعدادات التسجيل - Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined